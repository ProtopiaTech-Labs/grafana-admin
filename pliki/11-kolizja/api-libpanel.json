{
  "uid": "LOGIN-lp-poza-git",
  "name": "Ruch usług (LOGIN, poza Git Sync)",
  "kind": 1,
  "folderUid": "FOLDER_UID",
  "model": {
    "type": "timeseries",
    "title": "Ruch usług",
    "description": "Moduł 11, ćwiczenie 07. Library panel przez legacy /api/library-elements. Folder Git Sync odrzuca go z HTTP 409, folder Uczestnicy/LOGIN przyjmuje. Znaczniki loginu i folderu podmienia sed.",
    "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
    },
    "targets": [
      {
        "refId": "A",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "editorMode": "code",
        "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
        "legendFormat": "{{service_name}}",
        "range": true
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "reqps",
        "color": {
          "mode": "palette-classic-by-name"
        }
      },
      "overrides": []
    },
    "options": {
      "legend": {
        "displayMode": "list",
        "placement": "bottom",
        "calcs": []
      },
      "tooltip": {
        "mode": "multi",
        "sort": "desc"
      }
    }
  }
}
