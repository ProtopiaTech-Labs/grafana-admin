{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "LibraryPanel",
  "metadata": {
    "name": "LOGIN-lp-z-git"
  },
  "spec": {
    "type": "timeseries",
    "title": "Ruch usług (LOGIN, z Git)",
    "description": "Moduł 11, ćwiczenie 07. Library panel jako zasób K8s w repozytorium Git Sync. Sync zgłasza warning Kind=LibraryPanel, bo instancja nie wystawia LibraryPanel w /apis.",
    "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
    },
    "targets": [
      {
        "refId": "A",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "editorMode": "code",
        "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
        "legendFormat": "{{service_name}}",
        "range": true
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "reqps"
      },
      "overrides": []
    },
    "options": {}
  }
}
