{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "LOGIN-m06-zakladki",
    "annotations": {
      "grafana.app/folder": "uczestnicy-LOGIN"
    }
  },
  "spec": {
    "title": "M06 Zakładki i rzędy (wzorzec) — LOGIN",
    "description": "Moduł 6, ćwiczenie 02 (rozwiązanie). Zakładki Aplikacja (rząd powtarzany po service, Auto grid) i Platforma (Auto grid + Custom). Znacznik LOGIN.",
    "tags": [
      "szkolenie",
      "modul-06"
    ],
    "editable": true,
    "cursorSync": "Off",
    "preload": false,
    "links": [],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "service",
          "label": "Usługa",
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "current": {
            "text": [
              "checkout",
              "cart",
              "payment"
            ],
            "value": [
              "checkout",
              "cart",
              "payment"
            ]
          },
          "options": [],
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "prometheus"
            },
            "spec": {
              "qryType": 1,
              "query": "label_values(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"},service_name)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "definition": "label_values(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"},service_name)",
          "regex": "",
          "sort": "alphabeticalAsc",
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true
        }
      }
    ],
    "elements": {
      "ruch": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Ruch: $service",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
                        "legendFormat": "req/s",
                        "range": true,
                        "instant": false
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "bledy": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Błędy: $service",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
                        "legendFormat": "błędy/s",
                        "range": true,
                        "instant": false
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "p95": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Latencja p95: $service",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service_name=\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
                        "legendFormat": "p95",
                        "range": true,
                        "instant": false
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "s"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "cpu": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "CPU procesów (top 10 podów)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "topk(10, sum by (pod) (rate(process_cpu_seconds_total{namespace=\"monitoring\"}[$__rate_interval])))",
                        "legendFormat": "{{pod}}",
                        "range": true,
                        "instant": false
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "pamiec": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Pamięć RSS (top 10 podów)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "topk(10, sum by (pod) (process_resident_memory_bytes{namespace=\"monitoring\"}))",
                        "legendFormat": "{{pod}}",
                        "range": true,
                        "instant": false
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "restarty": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Restarty kontenerów (1h)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"monitoring\"}[1h]))",
                        "legendFormat": "restarty",
                        "range": false,
                        "instant": true
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "pody": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Pody w namespace monitoring",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "count(kube_pod_info{namespace=\"monitoring\"})",
                        "legendFormat": "pody",
                        "range": false,
                        "instant": true
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "title": "Aplikacja",
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "RED: $service",
                        "collapse": false,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "maxColumnCount": 3,
                            "columnWidthMode": "standard",
                            "rowHeightMode": "standard",
                            "fillScreen": false,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "ruch"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "bledy"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "p95"
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "repeat": {
                          "mode": "variable",
                          "value": "service"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "title": "Platforma",
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "Zasoby",
                        "collapse": false,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "maxColumnCount": 2,
                            "columnWidthMode": "standard",
                            "rowHeightMode": "standard",
                            "fillScreen": false,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "cpu"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "pamiec"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "Stabilność",
                        "collapse": false,
                        "layout": {
                          "kind": "GridLayout",
                          "spec": {
                            "items": [
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 0,
                                  "y": 0,
                                  "width": 12,
                                  "height": 6,
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "restarty"
                                  }
                                }
                              },
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 12,
                                  "y": 0,
                                  "width": 12,
                                  "height": 6,
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "pody"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "preferences": {
      "layout": {
        "kind": "AutoGridLayout",
        "spec": {
          "maxColumnCount": 3,
          "columnWidthMode": "standard",
          "rowHeightMode": "standard",
          "fillScreen": false,
          "items": []
        }
      }
    }
  }
}
