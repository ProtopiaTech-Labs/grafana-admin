{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "LOGIN-moje-uslugi",
    "annotations": {
      "grafana.app/folder": "uczestnicy-LOGIN"
    }
  },
  "spec": {
    "title": "M06 Moje usługi — LOGIN",
    "description": "Moduł 6, ćwiczenie 08 (rozwiązanie). Constant me = ${__user.login}; rząd Moje usługi widoczny tylko dla LOGIN-test1. To nie jest kontrola dostępu. Znacznik LOGIN.",
    "tags": [
      "szkolenie",
      "modul-06"
    ],
    "editable": true,
    "cursorSync": "Off",
    "preload": false,
    "links": [],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "timeSettings": {
      "timezone": "",
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "ConstantVariable",
        "spec": {
          "name": "me",
          "hide": "hideVariable",
          "skipUrlSync": true,
          "query": "${__user.login}",
          "current": {
            "text": "${__user.login}",
            "value": "${__user.login}"
          }
        }
      }
    ],
    "elements": {
      "kto": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Zalogowany: ${__user.login}",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
                        "legendFormat": "sklep req/s",
                        "range": true,
                        "instant": false
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": []
              }
            }
          },
          "description": "Tytuł interpoluje ${__user.login}. Anonim zobaczy pusty login."
        }
      },
      "moje-ruch": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Ruch: payment i checkout",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total{service_name=~\"payment|checkout\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
                        "legendFormat": "{{service_name}}",
                        "range": true,
                        "instant": false
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "moje-bledy": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Błędy: payment i checkout",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total{service_name=~\"payment|checkout\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
                        "legendFormat": "{{service_name}}",
                        "range": true,
                        "instant": false
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.1",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Dla wszystkich",
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 1,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "kto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Moje usługi",
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "moje-ruch"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "moje-bledy"
                        }
                      }
                    }
                  ]
                }
              },
              "conditionalRendering": {
                "kind": "ConditionalRenderingGroup",
                "spec": {
                  "visibility": "show",
                  "condition": "and",
                  "items": [
                    {
                      "kind": "ConditionalRenderingVariable",
                      "spec": {
                        "variable": "me",
                        "operator": "matches",
                        "value": "^LOGIN-test1$"
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "preferences": {
      "layout": {
        "kind": "AutoGridLayout",
        "spec": {
          "maxColumnCount": 3,
          "columnWidthMode": "standard",
          "rowHeightMode": "standard",
          "fillScreen": false,
          "items": []
        }
      }
    }
  }
}
