{
  "title": "LP-A",
  "description": "Moduł 3, ćwiczenie 16. Dashboard startowy z panelem p95 latency, który zamieniasz w library panel. Plik bez uid — Grafana nada nowy przy imporcie.",
  "tags": ["szkolenie", "modul-03", "library-panels"],
  "editable": true,
  "schemaVersion": 41,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p95 latency",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_spanmetrics_latency_bucket{service_name=~\"checkout|frontend|payment\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic-by-name" },
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
