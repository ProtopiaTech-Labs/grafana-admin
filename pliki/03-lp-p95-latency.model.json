{
  "type": "timeseries",
  "title": "p95 latency (standard)",
  "description": "Standard organizacji: p95 czasu odpowiedzi spanów serwerowych, próg SLO 500 ms. Model zarządzany przez Terraform (moduł 3, ćwiczenie 18).",
  "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
  },
  "targets": [
    {
      "refId": "A",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "editorMode": "code",
      "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
      "legendFormat": "{{service_name}}",
      "range": true
    }
  ],
  "fieldConfig": {
    "defaults": {
      "unit": "s",
      "color": {
        "mode": "palette-classic-by-name"
      },
      "custom": {
        "thresholdsStyle": {
          "mode": "dashed"
        }
      },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "green",
            "value": null
          },
          {
            "color": "red",
            "value": 0.5
          }
        ]
      }
    },
    "overrides": []
  },
  "options": {
    "legend": {
      "displayMode": "list",
      "placement": "bottom",
      "calcs": []
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  }
}
